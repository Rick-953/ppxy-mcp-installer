PORT=3333
HOST=127.0.0.1
WORKSPACE_DIR=/opt/ai-host-bridge/workspace
ALLOWED_HOSTS=localhost,127.0.0.1,000339.xyz,000993.xyz
MCP_API_KEYS=replace_with_a_long_random_api_key
FULL_MACHINE_ACCESS=1
PUBLIC_BASE_URL=https://000339.xyz
OAUTH_ISSUER=https://000339.xyz
OAUTH_RESOURCE=https://000339.xyz/mcp
OAUTH_SCOPE=mcp:root
OAUTH_STATIC_CLIENT_ID=chatgpt
OAUTH_STORE_PATH=/opt/ai-host-bridge/oauth-store.json
OAUTH_LOGIN_CODE=replace_with_access_code
LOG_DIR=/var/log/ai-host-bridge
LOG_RAW_AI_REQUESTS=1
LOG_MAX_BODY_BYTES=200000
